# ===========================================================================
# Multilingual file for the TOS 7 Docker application "mealiedocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Mealie"
auth         = "mealie-recipes"
version      = "@@VERSION@@"
descript     = "Mealie is a self-hosted recipe manager. Paste the address of a recipe page and Mealie imports the ingredients and steps into your own cookbook; from there you plan the week's meals, build a shopping list from the recipes you chose, and share everything with your household. This app runs the official Docker Hub image as a non-root container on your NAS and keeps recipes, photos, users and the database in the application data folder, so nothing is lost on restart or update."
release_note = "1. First release: Mealie 3.28.0 from Docker Hub, running as a non-root container. Recipes, photos and the database live in the application data folder and survive restarts and updates."
important    = "Requires DockerEngine (installed if missing); add a registry mirror if Docker Hub is unreachable. Open http://<NAS-IP>:8010/. First login: changeme@example.com with password MyPassword - change the e-mail and the password in the user settings right away. Everything is kept in DockerAppData/mealiedocker; keep data/.secret and data/.session_secret, they are needed for saved integrations and login sessions. Back up the data folder before uninstalling with data removal."

[zh-cn]
name         = "Mealie"
auth         = "mealie-recipes"
version      = "@@VERSION@@"
descript     = "Mealie 是自托管的菜谱管理器。把菜谱网页地址粘进去，Mealie 就会自动抓取食材与步骤存进你自己的菜谱库；之后可以安排每周菜单、按选中的菜谱生成购物清单，并与家人共享。本应用在 NAS 上以非 root 容器运行 Docker Hub 官方镜像，菜谱、图片、用户与数据库都保存在应用数据目录中，重启与更新都不会丢失。"
release_note = "1. 首次发布：来自 Docker Hub 的 Mealie 3.28.0，以非 root 容器运行。菜谱、图片与数据库保存在应用数据目录，重启与更新都不会丢失。"
important    = "需要 DockerEngine（缺失时应用中心会自动提示安装）；若 NAS 无法直连 Docker Hub，请先配置镜像加速。安装后打开 http://<NAS-IP>:8010/。首次登录使用内置管理员 changeme@example.com，密码 MyPassword，请立即在用户设置里修改邮箱与密码。所有数据都在 DockerAppData/mealiedocker 目录；data/.secret 与 data/.session_secret 请务必保留，否则已保存的集成密钥与会话将无法恢复。卸载并删除数据前请先备份应用数据目录。"

[zh-hk]
name         = "Mealie"
auth         = "mealie-recipes"
version      = "@@VERSION@@"
descript     = "Mealie 是自架式食譜管理器。把食譜網頁位址貼進去，Mealie 就會自動抓取材料與步驟存進你自己的食譜庫；之後可以安排每週菜單、依選中的食譜產生購物清單，並與家人共享。本應用在 NAS 上以非 root 容器執行 Docker Hub 官方映像，食譜、圖片、使用者與資料庫都保存在應用資料目錄中，重新啟動與更新都不會遺失。"
release_note = "1. 首次發佈：來自 Docker Hub 的 Mealie 3.28.0，以非 root 容器執行。食譜、圖片與資料庫保存在應用資料目錄，重新啟動與更新都不會遺失。"
important    = "需要 DockerEngine（缺少時應用中心會自動提示安裝）；若 NAS 無法直連 Docker Hub，請先設定映像加速。安裝後開啟 http://<NAS-IP>:8010/。首次登入使用內建管理員 changeme@example.com，密碼 MyPassword，請立即在使用者設定中修改電郵與密碼。所有資料都在 DockerAppData/mealiedocker 目錄；data/.secret 與 data/.session_secret 請務必保留，否則已儲存的整合金鑰與工作階段將無法還原。解除安裝並刪除資料前請先備份應用資料目錄。"

